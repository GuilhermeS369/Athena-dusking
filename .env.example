# Supabase público — necessário para login, banco e galeria no navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Apenas no servidor — necessário para o worker processar a fila.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-do-supabase
PUBLICATION_WORKER_SECRET=gere-um-segredo-longo-e-aleatorio
# Usado pelo Vercel Cron no header Authorization: Bearer <valor>.
CRON_SECRET=gere-outro-segredo-longo-e-aleatorio

# Instagram Login for Business — os mesmos dados do MVP que já publicava Reels.
# O client secret é usado apenas pelo callback no servidor, nunca pelo navegador.
INSTAGRAM_CLIENT_ID=37412665811681272
INSTAGRAM_CLIENT_SECRET=seu-client-secret-da-meta
REDIRECT_URI=http://localhost:3000/api/integrations/meta/callback

# O token de acesso do perfil é obtido e armazenado criptografado pelo sistema.
META_OAUTH_STATE_SECRET=gere-um-segredo-longo-e-aleatorio
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=chave-base64-de-32-bytes

# Opcional: a versão padrão atual da Graph API será usada se omitida.
META_GRAPH_API_VERSION=v26.0

# Worker dedicado em VPS — começa seguro em modo observação/dry-run.
PUBLICATION_WORKER_ID=athena-vps-publication-1
# Modos: observe, dispatch-endpoint ou direct.
PUBLICATION_WORKER_MODE=observe
PUBLICATION_WORKER_DRY_RUN=true
PUBLICATION_WORKER_POLL_INTERVAL_MS=5000
PUBLICATION_WORKER_HEARTBEAT_INTERVAL_MS=30000
PUBLICATION_WORKER_LIMIT=5
PUBLICATION_WORKER_LEASE_SECONDS=180
PUBLICATION_WORKER_META_CONCURRENCY=5
# Necessário somente para modo transitório dispatch-endpoint.
PUBLICATION_WORKER_APP_BASE_URL=https://seu-app.vercel.app

# Worker de geração assíncrona de agendamentos grandes — começa em observação.
PUBLICATION_GENERATION_WORKER_ID=athena-vps-generation-1
PUBLICATION_GENERATION_WORKER_MODE=observe
PUBLICATION_GENERATION_WORKER_DRY_RUN=true
PUBLICATION_GENERATION_WORKER_POLL_INTERVAL_MS=10000
PUBLICATION_GENERATION_WORKER_HEARTBEAT_INTERVAL_MS=30000
PUBLICATION_GENERATION_WORKER_LIMIT=1
PUBLICATION_GENERATION_WORKER_CHUNK_LIMIT=1
PUBLICATION_GENERATION_WORKER_LEASE_SECONDS=300
# Planos compactos de "Programar em massa": claim limitado e até 1.000 slots por passo.
PUBLICATION_GENERATION_WORKER_BULK_CHUNK_LIMIT=1
PUBLICATION_GENERATION_WORKER_BULK_STEP_SIZE=500
PUBLICATION_GENERATION_WORKER_BULK_MAX_FAILURES=3

# Teste de carga — usar preferencialmente em staging.
LOAD_TEST_ID=teste-local-001
LOAD_TEST_ORGANIZATION_ID=uuid-da-organizacao-de-teste
LOAD_TEST_PROFILE_LIMIT=10
LOAD_TEST_POSTS_PER_PROFILE=24
LOAD_TEST_START_OFFSET_MINUTES=43200
LOAD_TEST_MINUTES_BETWEEN_POSTS=60
LOAD_TEST_INSERT_CHUNK_SIZE=500
# Só use true em staging ou com workers reais pausados, pois cria itens due/vencidos.
LOAD_TEST_ALLOW_DUE_ITEMS=false
LOAD_TEST_CLAIM_LIMIT=5
LOAD_TEST_MAX_CYCLES=10
LOAD_TEST_SIMULATED_DELAY_MS=100
# Rollout de Programar em massa: all | managers | admins | off.
# Use admins no primeiro lote controlado e off para bloquear novas criações sem
# apagar planos ou publicações já materializadas.
BULK_PUBLICATION_ROLLOUT=all

# Somente staging: JWT curto de uma sessão admin/operator usado pelo cenário
# compacto. Nunca grave um token real no repositório ou no ambiente de produção.
BULK_LOAD_ADMIN_ACCESS_TOKEN=
BULK_LOAD_ALLOW_MUTATION=false
BULK_LOAD_ALLOW_CLEANUP=false
PROFILE_ANALYTICS_REFRESH_WORKER_LIMIT=5
# Perfis processados simultaneamente; limite intencional para respeitar as APIs externas.
PROFILE_ANALYTICS_REFRESH_WORKER_CONCURRENCY=3
PROFILE_ANALYTICS_QUEUE_V2_SHADOW_ENABLED=false
PROFILE_ANALYTICS_QUEUE_V2_SHADOW_ORGANIZATION_IDS=
PROFILE_ANALYTICS_QUEUE_V2_SHADOW_SOURCE_CLASSES=current,daily,posts
PROFILE_ANALYTICS_QUEUE_V2_SHADOW_LIMIT=20
PROFILE_ANALYTICS_QUEUE_V2_SHADOW_CONCURRENCY=5
PROFILE_ANALYTICS_QUEUE_V2_SHADOW_MAX_CONNECTION_LEASES=2
PROFILE_ANALYTICS_VPS_FALLBACK_STALE_SECONDS=120
PROFILE_ANALYTICS_VPS_WORKER_PREFIX=athena-vps-
PROFILE_ANALYTICS_DIRECT_ENABLED=false
PROFILE_ANALYTICS_DIRECT_ORGANIZATION_IDS=
PROFILE_ANALYTICS_DIRECT_LIMIT=1
PROFILE_ANALYTICS_DIRECT_CONCURRENCY=1
PROFILE_ANALYTICS_DIRECT_LEASE_SECONDS=300
PROFILE_ANALYTICS_QUEUE_V2_LIVE_CURRENT_ENABLED=false
PROFILE_ANALYTICS_QUEUE_V2_LIVE_CURRENT_ORGANIZATION_IDS=
PROFILE_ANALYTICS_QUEUE_V2_LIVE_CURRENT_LIMIT=1
PROFILE_ANALYTICS_QUEUE_V2_LIVE_CURRENT_CONCURRENCY=1
PROFILE_ANALYTICS_QUEUE_V2_LIVE_DAILY_ENABLED=false
PROFILE_ANALYTICS_QUEUE_V2_LIVE_DAILY_ORGANIZATION_IDS=
PROFILE_ANALYTICS_QUEUE_V2_LIVE_DAILY_LIMIT=1
PROFILE_ANALYTICS_QUEUE_V2_LIVE_DAILY_CONCURRENCY=1
PROFILE_ANALYTICS_QUEUE_V2_LIVE_POSTS_ENABLED=false
PROFILE_ANALYTICS_QUEUE_V2_LIVE_POSTS_ORGANIZATION_IDS=
PROFILE_ANALYTICS_QUEUE_V2_LIVE_POSTS_LIMIT=1
PROFILE_ANALYTICS_QUEUE_V2_LIVE_POSTS_CONCURRENCY=1

# Módulo X/Twitter — desligado por padrão; nunca coloque valores secretos neste arquivo.
TWITTER_MODULE_ENABLED=false
TWITTER_CANARY_ORGANIZATION_IDS=
TWITTER_ANALYTICS_ENABLED=false
TWITTER_WORKER_SECRET=
TWITTER_WORKER_APP_BASE_URL=
TWITTER_WORKER_POLL_INTERVAL_MS=5000
TWITTER_WORKER_LEASE_SECONDS=300
TWITTER_ZERNIO_WEBHOOK_SECRET=
TWITTER_PUBLICATION_WORKER_ENABLED=false
TWITTER_PUBLICATION_MODE=shadow
TWITTER_PUBLICATION_WORKER_LIMIT=1
TWITTER_PUBLICATION_WORKER_CONCURRENCY=1
TWITTER_GENERATION_WORKER_ENABLED=false
TWITTER_GENERATION_WORKER_CONCURRENCY=1
TWITTER_SYNC_WORKER_ENABLED=false
TWITTER_SYNC_WORKER_CONCURRENCY=1
TWITTER_ANALYTICS_WORKER_ENABLED=false
TWITTER_ANALYTICS_WORKER_CONCURRENCY=1
TWITTER_ZERNIO_REQUEST_TIMEOUT_MS=30000
TWITTER_REVIEW_TOKEN_SECRET=
TWITTER_FALLBACK_ENABLED=false
TWITTER_FALLBACK_LIVE_ENABLED=false
TWITTER_FALLBACK_STALE_SECONDS=120
