{
  "name": "athena-scheduler",
  "version": "2.0.0",
  "private": true,
  "description": "Athena Scheduler: painel multiempresa para organização e publicação de conteúdo no Instagram.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test lib/**/*.test.ts",
    "worker:publication": "node scripts/workers/publication-worker.mjs",
    "worker:publication:once": "node scripts/workers/publication-worker.mjs --once",
    "worker:publication-generation": "node scripts/workers/publication-generation-worker.mjs",
    "worker:publication-generation:once": "node scripts/workers/publication-generation-worker.mjs --once",
    "worker:media-maintenance": "node scripts/workers/media-maintenance-worker.mjs",
    "worker:media-maintenance:once": "node scripts/workers/media-maintenance-worker.mjs --once",
    "worker:profile-analytics": "node scripts/workers/profile-analytics-refresh-worker.mjs",
    "worker:profile-analytics:once": "node scripts/workers/profile-analytics-refresh-worker.mjs --once",
    "worker:profile-analytics:direct": "tsx scripts/workers/profile-analytics-direct-worker.ts",
    "worker:profile-analytics:direct:once": "tsx scripts/workers/profile-analytics-direct-worker.ts --once",
    "worker:zernio-sync": "node scripts/workers/zernio-sync-worker.mjs",
    "worker:zernio-sync:once": "node scripts/workers/zernio-sync-worker.mjs --once",
    "worker:operational-health": "node scripts/workers/validate-operational-health.mjs",
    "worker:publication-telemetry": "node scripts/workers/validate-publication-dispatch-telemetry.mjs",
    "worker:twitter:publication": "node scripts/workers/twitter-worker.mjs --role=publication",
    "worker:twitter:publication:once": "node scripts/workers/twitter-worker.mjs --role=publication --once",
    "worker:twitter:generation": "node scripts/workers/twitter-worker.mjs --role=generation",
    "worker:twitter:sync": "node scripts/workers/twitter-worker.mjs --role=sync",
    "worker:twitter:analytics": "node scripts/workers/twitter-worker.mjs --role=analytics",
    "worker:twitter:reconcile": "node scripts/workers/twitter-worker.mjs --role=reconcile",
    "load-test:safe-smoke": "node scripts/load-test/safe-smoke.mjs",
    "load-test:synthetic-scale": "node scripts/load-test/synthetic-scale-smoke.mjs",
    "load-test:synthetic-claim": "node scripts/load-test/synthetic-claim-simulation.mjs",
    "load-test:seed": "node scripts/load-test/seed-load-data.mjs",
    "load-test:simulate": "node scripts/load-test/run-worker-simulation.mjs",
