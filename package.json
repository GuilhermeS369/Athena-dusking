    "load-test:cleanup": "node scripts/load-test/cleanup-load-data.mjs",
    "load-test:bulk-report": "node scripts/load-test/report-bulk-rotation-results.mjs",
    "load-test:bulk-scenarios": "node scripts/load-test/bulk-rotation-scale-scenarios.mjs",
    "load-test:bulk-cleanup": "node scripts/load-test/cleanup-bulk-rotation-data.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.52.0",
    "next": "^15.5.7",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsx": "^4.20.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.8.2"
